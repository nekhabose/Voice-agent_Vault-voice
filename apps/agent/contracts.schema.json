{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LedgerlineWorkerContracts",
  "definitions": {
    "Effect": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "GREET"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "ASK_FOR"
            },
            "key": {
              "type": "string",
              "enum": [
                "caller_name",
                "callback_phone",
                "service_address",
                "problem_description",
                "urgency",
                "appointment_window"
              ]
            }
          },
          "required": [
            "type",
            "key"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "READ_BACK"
            },
            "key": {
              "type": "string",
              "enum": [
                "caller_name",
                "callback_phone",
                "service_address",
                "problem_description",
                "urgency",
                "appointment_window"
              ]
            }
          },
          "required": [
            "type",
            "key"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "ESCALATE"
            },
            "reason": {
              "type": "string",
              "enum": [
                "EMERGENCY_HAZARD",
                "OUT_OF_SERVICE_AREA",
                "CALLER_REQUESTED_HUMAN",
                "REPEATED_EXTRACTION_FAILURE",
                "AGENT_ERROR"
              ]
            },
            "action": {
              "type": "string",
              "enum": [
                "WARM_TRANSFER",
                "DIAL_911_GUIDANCE",
                "DECLINE"
              ]
            },
            "hazard": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "category": {
                      "type": "string",
                      "enum": [
                        "GAS_LEAK",
                        "CARBON_MONOXIDE",
                        "FIRE",
                        "ELECTRICAL_ARC",
                        "FLOODING",
                        "SEWAGE_BACKUP",
                        "NO_HEAT_FREEZING",
                        "VULNERABLE_PERSON_AT_RISK"
                      ]
                    },
                    "action": {
                      "type": "string",
                      "enum": [
                        "WARM_TRANSFER",
                        "DIAL_911_GUIDANCE"
                      ]
                    },
                    "matchedText": {
                      "type": "string"
                    },
                    "ruleId": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "category",
                    "action",
                    "matchedText",
                    "ruleId"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "reason",
            "action",
            "hazard"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "CREATE_PENDING_BOOKING"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "SAY_FILLER"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "ANSWER_FAQ"
            },
            "answer": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "answer"
          ],
          "additionalProperties": false
        }
      ]
    },
    "PendingBooking": {
      "type": "object",
      "properties": {
        "callId": {
          "type": "string",
          "format": "uuid"
        },
        "tenantId": {
          "type": "string",
          "format": "uuid"
        },
        "customer": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "phone": {
              "type": "string",
              "pattern": "^\\+[1-9]\\d{1,14}$"
            },
            "locale": {
              "type": "string",
              "enum": [
                "en",
                "es",
                "hi",
                "tl",
                "vi"
              ]
            }
          },
          "required": [
            "name",
            "phone",
            "locale"
          ],
          "additionalProperties": false
        },
        "address": {
          "type": "object",
          "properties": {
            "line1": {
              "type": "string",
              "minLength": 1
            },
            "line2": {
              "type": "string"
            },
            "city": {
              "type": "string",
              "minLength": 1
            },
            "state": {
              "type": "string",
              "minLength": 2,
              "maxLength": 2
            },
            "postalCode": {
              "type": "string",
              "pattern": "^\\d{5}(-\\d{4})?$"
            },
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "lng": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "formatted": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "line1",
            "city",
            "state",
            "postalCode",
            "formatted"
          ],
          "additionalProperties": false
        },
        "problemDescription": {
          "type": "string",
          "minLength": 3
        },
        "urgency": {
          "type": "string",
          "enum": [
            "ROUTINE",
            "SOON",
            "SAME_DAY",
            "EMERGENCY"
          ]
        },
        "window": {
          "type": "object",
          "properties": {
            "startsAt": {
              "type": "string",
              "format": "date-time"
            },
            "endsAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "startsAt",
            "endsAt"
          ],
          "additionalProperties": false
        },
        "jobTypeId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "callId",
        "tenantId",
        "customer",
        "address",
        "problemDescription",
        "urgency",
        "window",
        "jobTypeId"
      ],
      "additionalProperties": false
    }
  }
}
